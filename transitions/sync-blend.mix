# Sync blend - locked together for the whole overlap, then let go.
#
# The plainest use of sync there is, and the one most mixes want: the arriving track is
# pulled to the playing one's tempo and started on one of its own bar lines, so the two
# count the same bars for as long as they are both audible. Once the old one is gone the
# new one is walked back to its own speed slowly enough that nobody hears it happen.
#
# A `tempo` lane is what asks for all of that. 0 is "whatever the other deck is doing",
# 1 is "your own speed"; the player works out the ratio and the bar line for itself.

name    Sync blend
note    locked to the old tempo through the blend, then eased back to its own
bars    16
align   beat
power   free

lane out gain
    bar 0     1.0    power-down
    bar 8     0.0    hold
    bar 16    0.0    hold

lane in gain
    bar 0     0.0    power-up
    bar 8     1.0    hold
    bar 16    1.0    hold

lane in bass
    bar 0     -24    smooth
    bar 6       0    hold
    bar 16      0    hold

# Locked while both are up, then eight bars to walk back. Long enough that a five per cent
# stretch unwinds at well under a per cent a bar, which is under what an ear will catch.
lane in tempo
    bar 0     0.0    hold
    bar 8     0.0    smooth
    bar 16    1.0    hold
